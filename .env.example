# Copy this file to ".env" and fill in your values.
# The real ".env" file is git-ignored and must never be committed.

# Your Google Gemini API key. Leave blank to run in deterministic demo mode.
GEMINI_API_KEY=

# Model to use. Configurable so the engine is never hard-coded in the source.
GEMINI_MODEL=gemini-2.5-flash

# Optional overrides (defaults are usually fine).
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# REQUEST_TIMEOUT=20
